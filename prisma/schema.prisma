// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int               @id @default(autoincrement())
  email          String            @unique
  name           String
  password       String
  phone_number   String            @unique
  gender         String
  role_id        Int
  role_name      Role              @relation(fields: [role_id], references: [id])
  refresh_token  String?
  updated_at     DateTime          @updatedAt
  created_at     DateTime          @default(now())
  addresses      Addresses[]
  sellerProfiles Seller_Profiles[]

  @@map("users")
}

model Role {
  id        Int    @id @default(autoincrement())
  role_name String @unique
  users     User[]

  @@map("roles")
}

model Addresses {
  id           Int      @id @default(autoincrement())
  user_id      Int
  address_line String
  city         String
  state        String
  country      String
  pin_code     String
  user         User     @relation(fields: [user_id], references: [id])
  created_at   DateTime
  updated_at   DateTime
}

model Seller_Profiles {
  id                  Int        @id @default(autoincrement())
  user_id             Int
  shop_name           String
  gst_number          String
  bank_account_number String
  ifsc_code           String
  created_at          DateTime   @default(now()) @db.Timestamp()
  updated_at          DateTime   @default(now()) @db.Timestamp()
  user                User       @relation(fields: [user_id], references: [id])
  products            Products[]

  @@map("seller_profiles")
}

model Products {
  id          Int             @id @default(autoincrement())
  seller_id   Int
  seller      Seller_Profiles @relation(fields: [seller_id], references: [id])
  name        String          @db.VarChar(255)
  description String          @db.VarChar(255)
  price       Decimal         @db.Decimal(10, 2)
  discount    Decimal?        @default(0) @db.Decimal(10, 2)
  stock       Int
  status      ProductStatus          @default(ACTIVE)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @default(now())

  @@map("products")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  AVAILABLE
}
